{
  "name": "dead-routes",
  "version": "0.1.0",
  "description": "Find dead routes, unused exports, and unreachable code in your Node.js/TypeScript codebase",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "dead-routes": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "dead-code",
    "unused-routes",
    "unused-exports",
    "code-analysis",
    "dead-code-elimination",
    "static-analysis",
    "typescript",
    "nodejs",
    "express",
    "fastify",
    "nextjs"
  ],
  "author": {
    "name": "Luis Angel Martinez",
    "email": "offluisangel@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/offluisangel/dead-routes.git"
  },
  "homepage": "https://github.com/offluisangel/dead-routes#readme",
  "bugs": {
    "url": "https://github.com/offluisangel/dead-routes/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@typescript-eslint/typescript-estree": "^8.59.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fastest-levenshtein": "^1.0.16",
    "glob": "^13.0.6",
    "ora": "^9.4.0"
  }
}
